#version=1.1
#URL=https://github.com/tailscale-dev/ScaleTail
#COMPOSE_PROJECT_NAME= # Optional: only use when running multiple deployments on the same infrastructure.

# Service Configuration
SERVICE=kosync # Used as hostname in Tailscale and for container naming (app-${SERVICE})
IMAGE_URL=koreader/kosync:latest # Official KOReader sync server image

# User Registration
ENABLE_USER_REGISTRATION=true # Set to false after creating your account to prevent open registrations

# Network Configuration
SERVICEPORT=17200 # Port to expose to local network if uncommenting ports in compose.yml
DNS_SERVER=9.9.9.9 # Preferred DNS server for Tailscale

# Tailscale Configuration
# Generate an auth key from your Tailscale admin console (Ephemeral + Reusable recommended)
TS_AUTHKEY=

# Volumes Location
DATA_DIR=.
