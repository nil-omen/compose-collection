# Service Configuration
SERVICE=dockge # Used as hostname in Tailscale and for container naming
IMAGE_URL=louislam/dockge:1 # Official Dockge image

# Network Configuration
SERVICEPORT=5001 # Dockge's default port. Uncomment the "ports:" section in compose.yaml to expose locally.
DNS_SERVER=9.9.9.9 # Preferred DNS server for Tailscale. Uncomment the "dns:" section in compose.yaml to enable.

# Tailscale Configuration
# Generate an ephemeral, reusable auth key from your Tailscale admin console
TS_AUTHKEY=
# Volumes Location
# Base directory for the Tailscale state and Dockge app data (e.g., /home/user/docker)
DATA_DIR=

# Stacks Directory
# ⚠️ READ IT CAREFULLY.
# ⚠️ 1. FULL path only. No relative path (MUST)
# ⚠️ 2. Left Stacks Path === Right Stacks Path (MUST)
STACKS_DIR=
